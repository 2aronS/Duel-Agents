# Duel Agents API key (required for all integrations).
# Get yours at https://duelagents.com/dashboard/settings
DUEL_API_KEY=duel_yourprefix_your32charactersecretkeyhere

# The installer also accepts this alias if DUEL_API_KEY is unset.
# DUEL_AGENTS_API_KEY=duel_yourprefix_your32charactersecretkeyhere

# Optional: override proxy URL (staging only)
# DUEL_PROXY_URL=https://duelagents.com/v1

# Optional: custom OpenClaw config path (must be inside ~/.openclaw)
# OPENCLAW_CONFIG_PATH=~/.openclaw/openclaw.json
