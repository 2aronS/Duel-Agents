// Merge this block into ~/.openclaw/openclaw.json
// Or run: npx @duel-agents/install openclaw

{
  models: {
    mode: "merge",
    providers: {
      duel: {
        baseUrl: "https://duelagents.com/v1",
        apiKey: "${DUEL_API_KEY}",
        api: "openai-completions",
        models: [
          {
            id: "duel-auto",
            name: "Duel Auto",
            reasoning: false,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 200000,
            maxTokens: 8192,
          },
        ],
      },
    },
  },
  agents: {
    defaults: {
      model: { primary: "duel/duel-auto" },
      models: {
        "duel/duel-auto": { alias: "Duel" },
      },
    },
  },
  // Keep your DUEL_API_KEY in ~/.openclaw/.env, not in this file.
  // The provider above reads it via the ${DUEL_API_KEY} reference.
  env: {
    DUEL_PROXY_URL: "https://duelagents.com/v1",
  },
}
